{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mimo-native/amazon-ad-manifest.schema.json",
  "title": "MiMo Native Amazon Ad Analysis Manifest",
  "type": "object",
  "required": ["manifest_version", "analysis_id", "as_of", "fetched_at", "files"],
  "properties": {
    "manifest_version": { "type": "string", "const": "1.0" },
    "analysis_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*[\\\\/])(?![A-Za-z]:)(?!.*\\.\\.)[^\\u0000-\\u001f]+$" },
    "as_of": { "type": "string", "format": "date-time" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "requested_level": { "type": "string", "enum": ["A", "B", "C"] },
    "files": {
      "type": "object",
      "required": ["product_performance", "ad_performance", "search_terms"],
      "properties": {
        "product_performance": { "type": ["string", "null"], "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.).+$" },
        "ad_performance": { "type": ["string", "null"], "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.).+$" },
        "search_terms": { "type": ["string", "null"], "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.).+$" },
        "brand_attribution": { "type": ["string", "null"], "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.).+$" },
        "listing_overlay": { "type": ["string", "null"], "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.).+$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
