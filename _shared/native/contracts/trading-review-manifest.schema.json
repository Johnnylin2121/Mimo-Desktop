{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mimo-native/trading-review-manifest.schema.json",
  "title": "MiMo Native Trading Review Manifest",
  "type": "object",
  "required": ["manifest_version", "run_id", "phase", "as_of", "fetched_at", "files"],
  "properties": {
    "manifest_version": { "type": "string", "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*[\\\\/])(?![A-Za-z]:)(?!.*\\.\\.)[^\\u0000-\\u001f]+$" },
    "phase": { "type": "string", "enum": ["premarket", "intraday", "postmarket"] },
    "as_of": { "type": "string", "format": "date-time" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "files": {
      "type": "object",
      "properties": {
        "previous_review": { "type": "string" },
        "current_review": { "type": "string" },
        "early_read": { "type": "string" },
        "plans": { "type": "string" },
        "memory": { "type": "string" },
        "market_snapshot": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
